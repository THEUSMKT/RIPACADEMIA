---
import { business } from '../data/business';
import Photo from './Photo.astro';
import WhatsAppLink from './WhatsAppLink.astro';
---

<section class="section final" aria-labelledby="final-title">
  <div class="container final__grid">
    <div class="final__copy" data-reveal>
      <p class="eyebrow">Próximo passo</p>
      <h2 id="final-title">Seu próximo treino começa com uma conversa.</h2>
      <p class="lede">Fale com a equipe pelo WhatsApp, consulte as condições do Free Pass e combine sua visita.</p>
      <div class="final__actions">
        <WhatsAppLink intent="free_pass" placement="fechamento" ctaId="fechamento_free_pass">
          {business.freePass.cta}
        </WhatsAppLink>
        <p class="final__alt">
          Prefere ligar? <a class="text-link" href={`tel:${business.phoneE164}`}>{business.whatsappDisplay}</a>
        </p>
      </div>
    </div>
    <div class="final__media" data-reveal>
      <div class="frame final__frame">
        <Photo id="acompanhamento-no-aparelho" sizes="(min-width: 1024px) 36vw, 92vw" />
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    background: var(--surface);
    overflow: hidden;
  }
  /* Brilho vermelho estático na base: eco da onda do hero, sem segundo renderer. */
  .final::after {
    content: '';
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: -60px;
    height: 160px;
    background: radial-gradient(60% 50% at 70% 100%, rgb(242 10 22 / 0.28), transparent 70%);
    pointer-events: none;
  }
  .final__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }
  .final__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .final__copy h2 {
    font-size: clamp(2.4rem, 1.4rem + 4vw, 4.6rem);
  }
  .final__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 6px;
  }
  .final__alt {
    color: var(--muted);
  }
  .final__alt a {
    color: var(--text);
    font-weight: 600;
  }
  .final__frame {
    aspect-ratio: 4 / 4.6;
  }
  .final__frame :global(img) {
    height: 100%;
  }
  @media (max-width: 1023px) {
    .final__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .final__frame {
      aspect-ratio: 4 / 3.4;
    }
  }
  @media (max-width: 599px) {
    .final__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
