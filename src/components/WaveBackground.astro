---
/**
 * Fundo decorativo Ribbon Glow, usado no hero e no convite "Venha fazer parte desse time!".
 *
 * Camadas (de baixo para cima, todas aria-hidden e sem eventos de ponteiro):
 *  1. fundo estático equivalente (SVG com gradientes): aparece antes do renderer iniciar, com movimento
 *     reduzido, sem WebGL2 ou em caso de erro. Há um desenho para telas largas e outro para estreitas;
 *  2. canvas WebGL2 animado (src/scripts/wave-controller.ts), em desktop e mobile;
 *  3. máscara escura localizada, só onde há texto, para manter o contraste.
 *
 * A seção que recebe a onda precisa de data-wave-host e position: relative. O controle
 * "Pausar movimento" (MotionToggle) fica fora deste bloco para não herdar pointer-events: none.
 */
interface Props {
  /** Prefixo único para os ids dos gradientes do SVG. */
  id: string;
  variant: 'hero' | 'convite';
  /** Deslocamento da faixa (unidades da altura da seção) em telas ≥ 1024 px e < 1024 px. */
  offsetWide: [number, number];
  offsetNarrow: [number, number];
  /** Tamanho da faixa (50–200, 100 = original) em telas ≥ 1024 px e < 1024 px. */
  sizeWide?: number;
  sizeNarrow?: number;
}
const { id, variant, offsetWide, offsetNarrow, sizeWide = 100, sizeNarrow = 100 } = Astro.props;
const g = (name: string) => `${id}-${name}`;
---

<div
  class={`wave wave--${variant}`}
  aria-hidden="true"
  data-wave
  data-offset-wide={offsetWide.join(',')}
  data-offset-narrow={offsetNarrow.join(',')}
  data-size-wide={sizeWide}
  data-size-narrow={sizeNarrow}
>
  <svg class="wave__static wave__static--wide" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" focusable="false">
    <defs>
      <linearGradient id={g('w')} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#8F1018" stop-opacity="0" />
        <stop offset="0.35" stop-color="#8F1018" stop-opacity="0.9" />
        <stop offset="0.62" stop-color="#F20A16" />
        <stop offset="1" stop-color="#8F1018" stop-opacity="0.2" />
      </linearGradient>
      <filter id={g('blur')} x="-10%" y="-50%" width="120%" height="200%">
        <feGaussianBlur stdDeviation="14" />
      </filter>
      <filter id={g('soft')} x="-10%" y="-50%" width="120%" height="200%">
        <feGaussianBlur stdDeviation="2.5" />
      </filter>
    </defs>
    <g fill="none" stroke={`url(#${g('w')})`} stroke-linecap="round">
      <path d="M-40 820 C 260 760, 520 860, 760 700 S 1180 520, 1500 610" stroke-width="70" opacity="0.32" filter={`url(#${g('blur')})`} />
      <path d="M-40 828 C 260 768, 520 868, 760 708 S 1180 528, 1500 618" stroke-width="6" opacity="0.75" filter={`url(#${g('soft')})`} />
      <path d="M-40 850 C 280 800, 540 880, 780 742 S 1200 580, 1500 660" stroke-width="2" opacity="0.5" />
    </g>
  </svg>
  <svg class="wave__static wave__static--narrow" viewBox="0 0 400 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <linearGradient id={g('n')} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#8F1018" stop-opacity="0.2" />
        <stop offset="0.45" stop-color="#F20A16" />
        <stop offset="1" stop-color="#8F1018" stop-opacity="0.3" />
      </linearGradient>
      <!-- Filtros próprios: o SVG largo fica oculto em telas estreitas e não pode emprestar os dele. -->
      <filter id={g('nblur')} x="-10%" y="-50%" width="120%" height="200%">
        <feGaussianBlur stdDeviation="12" />
      </filter>
      <filter id={g('nsoft')} x="-10%" y="-50%" width="120%" height="200%">
        <feGaussianBlur stdDeviation="2" />
      </filter>
    </defs>
    <g fill="none" stroke={`url(#${g('n')})`} stroke-linecap="round">
      <path d="M-60 330 C 80 260, 180 420, 300 300 S 420 200, 470 250" stroke-width="56" opacity="0.3" filter={`url(#${g('nblur')})`} />
      <path d="M-60 336 C 80 266, 180 426, 300 306 S 420 206, 470 256" stroke-width="4" opacity="0.8" filter={`url(#${g('nsoft')})`} />
      <path d="M-60 760 C 90 700, 200 860, 320 740 S 430 660, 470 700" stroke-width="56" opacity="0.28" filter={`url(#${g('nblur')})`} />
      <path d="M-60 766 C 90 706, 200 866, 320 746 S 430 666, 470 706" stroke-width="3" opacity="0.7" />
    </g>
  </svg>
  <canvas class="wave__canvas" data-wave-canvas></canvas>
  <div class="wave__mask"></div>
</div>

<script>
  import { initWaves } from '../scripts/wave-controller';
  initWaves();
</script>

<style>
  .wave {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
  }
  .wave__static,
  .wave__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wave__static {
    opacity: 0.7;
    transition: opacity 0.8s var(--ease);
  }
  .wave__static--narrow {
    display: none;
  }
  .wave__canvas {
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  /* Renderer ativo: o canvas assume o papel do fundo estático. */
  :global([data-wave='live']) > .wave .wave__canvas {
    opacity: var(--wave-opacity);
  }
  :global([data-wave='live']) > .wave .wave__static {
    opacity: 0;
  }

  /* Hero: máscara só atrás da coluna de texto; a faixa aparece na base e na transição texto/foto. */
  .wave--hero {
    --wave-opacity: 0.42;
  }
  .wave--hero .wave__mask {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 34% 52% at 26% 50%, rgb(9 9 11 / 0.82) 0%, rgb(9 9 11 / 0.7) 60%, rgb(9 9 11 / 0) 100%),
      linear-gradient(180deg, rgb(9 9 11 / 0.75) 0%, rgb(9 9 11 / 0) 22%);
  }
  /* Convite: fundo preto com a onda ao redor do título e da foto; máscara leve só atrás do título. */
  .wave--convite {
    --wave-opacity: 0.6;
  }
  .wave--convite .wave__mask {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 26% at 50% 16%, rgb(9 9 11 / 0.6) 0%, rgb(9 9 11 / 0) 100%);
  }

  @media (max-width: 1023px) {
    .wave__static--wide {
      display: none;
    }
    .wave__static--narrow {
      display: block;
    }
    .wave--hero {
      --wave-opacity: 0.55;
    }
    .wave--convite .wave__mask {
      background: radial-gradient(ellipse 95% 22% at 50% 19%, rgb(9 9 11 / 0.8) 0%, rgb(9 9 11 / 0.5) 55%, rgb(9 9 11 / 0) 100%);
    }
    /* Texto ocupa a largura toda: escurece só a faixa do texto e libera as bordas e a área da foto. */
    .wave--hero .wave__mask {
      background:
        radial-gradient(ellipse 80% 16% at 22% 15%, rgb(9 9 11 / 0.55) 0%, rgb(9 9 11 / 0) 100%),
        linear-gradient(90deg, rgb(9 9 11 / 0.5) 0%, rgb(9 9 11 / 0.15) 70%, rgb(9 9 11 / 0) 100%);
    }
  }
</style>
