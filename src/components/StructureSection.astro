---
import type { PhotoId } from '../data/photos';
import { photoSize } from '../lib/images';
import Photo from './Photo.astro';
import WhatsAppLink from './WhatsAppLink.astro';

// Só o que é visível nas fotos: sem metragem, contagem de máquinas, acessibilidade ou estacionamento.
const highlights = [
  { title: 'Salão de musculação', text: 'Fileiras de aparelhos com espaço de circulação entre eles.' },
  { title: 'Aparelhos e anilhas', text: 'Equipamentos de força em vermelho e preto, halteres e suportes.' },
  { title: 'Mezanino e área de treino', text: 'Escada de acesso ao piso superior e área para outros treinos.' },
];

// Par de fotos: caixas iguais com a proporção mais alta das duas; cada foto cabe inteira (object-fit: contain).
const pair: { id: PhotoId; phrase: string }[] = [
  { id: 'estrutura-vista-geral', phrase: 'Estrutura pensada para o seu melhor desempenho.' },
  { id: 'estrutura-escada', phrase: 'O espaço ideal para a sua evolução.' },
];
const tallest = pair.map(({ id }) => photoSize(id)).reduce((a, b) => (b.height / b.width > a.height / a.width ? b : a));
const boxRatio = `${tallest.width} / ${tallest.height}`;
---

<section class="section structure" id="estrutura" aria-labelledby="estrutura-title">
  <div class="container structure__grid">
    <div class="structure__copy" data-reveal>
      <p class="eyebrow">Estrutura real</p>
      <h2 id="estrutura-title">Conheça o espaço onde seu próximo treino acontece.</h2>
      <p class="lede">
        O salão da RIP reúne aparelhos de musculação, pesos livres e uma área de treino integrada, em um ambiente
        iluminado em vermelho e preto. A melhor forma de avaliar é ver de perto.
      </p>
      <ul class="structure__list">
        {
          highlights.map((h, i) => (
            <li>
              <span class="structure__num" aria-hidden="true">
                0{i + 1}
              </span>
              <div>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <WhatsAppLink intent="free_pass" placement="estrutura" ctaId="estrutura_conhecer" icon="arrow">
        Quero conhecer a RIP
      </WhatsAppLink>
    </div>

    <div class="structure__photos" style={`--box-ratio: ${boxRatio}`}>
      {
        pair.map((p) => (
          <figure class="structure__card" data-reveal>
            <div class="frame frame--contain structure__frame">
              <Photo id={p.id} sizes="(min-width: 1024px) 340px, (min-width: 600px) 46vw, 46vw" />
            </div>
            <figcaption class="structure__phrase">{p.phrase}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .structure {
    background: var(--background);
  }
  .structure__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .structure__copy {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .structure__list {
    list-style: none;
    padding: 0;
    margin: 6px 0 10px;
    display: grid;
    gap: 0;
    width: 100%;
  }
  .structure__list li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .structure__list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .structure__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--brand-red);
    padding-top: 2px;
  }
  .structure__list h3 {
    font-size: 1.35rem;
  }
  .structure__list p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.98rem;
  }

  /* Duas fotos do mesmo tamanho, lado a lado em qualquer largura, alinhadas no topo e na base. */
  .structure__photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 2vw, 24px);
    align-items: start;
  }
  .structure__card {
    position: relative;
    margin: 0;
  }
  .structure__frame {
    aspect-ratio: var(--box-ratio);
  }
  /* Frase sobreposta no topo da foto, com gradiente localizado só atrás do texto. */
  .structure__phrase {
    position: absolute;
    inset: 0 0 auto 0;
    padding: clamp(10px, 2vw, 22px) clamp(10px, 2vw, 22px) clamp(28px, 5vw, 56px);
    background: linear-gradient(180deg, rgb(9 9 11 / 0.82) 0%, rgb(9 9 11 / 0.55) 55%, rgb(9 9 11 / 0) 100%);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 0.8rem + 1.3vw, 1.85rem);
    line-height: 1.08;
    letter-spacing: 0.01em;
    text-wrap: balance;
    hyphens: none;
    color: #fff;
  }
  /* Entrada da frase: uma vez, ao aparecer na tela, depois da foto; a segunda com atraso discreto. */
  :global(.reveal-on) .structure__phrase {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.7s var(--ease) 0.25s,
      transform 0.7s var(--ease) 0.25s;
  }
  :global(.reveal-on) .structure__card + .structure__card .structure__phrase {
    transition-delay: 0.4s;
  }
  :global(.reveal-on) .structure__card:global(.is-in) .structure__phrase {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1023px) {
    .structure__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .structure__copy {
      position: static;
    }
  }
</style>
