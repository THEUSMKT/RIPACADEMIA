---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileConversionBar from '../components/MobileConversionBar.astro';
import { business } from '../data/business';

// O texto acompanha o que está efetivamente ativado no build.
const { ga4MeasurementId, gtmContainerId, metaPixelId } = business.analytics;
const tools = [
  ga4MeasurementId && 'Google Analytics 4 (medição de visitas e cliques)',
  gtmContainerId && 'Google Tag Manager (gerenciamento das tags de medição)',
  metaPixelId && 'Meta Pixel (medição de anúncios no Facebook e Instagram)',
].filter(Boolean) as string[];
---

<BaseLayout
  title="Privacidade | RIP Academia"
  description="Como o site da RIP Academia funciona em relação a dados, contato pelo WhatsApp e ferramentas de medição."
  path="privacidade/"
>
  <Header home={false} />
  <main id="conteudo" tabindex="-1" class="section">
    <article class="container privacy">
      <p class="eyebrow">Privacidade</p>
      <h1>Como este site funciona</h1>

      <h2>Contato</h2>
      <p>
        Este site não tem formulários e não coleta nome, telefone ou mensagens. Os botões de contato abrem o WhatsApp com
        uma mensagem sugerida, que você pode editar antes de enviar. A conversa acontece no WhatsApp, sob as regras desse
        serviço. O botão “Como chegar” abre o Google Maps.
      </p>

      <h2>Medição de visitas e anúncios</h2>
      {
        tools.length === 0 ? (
          <p>
            No momento, o site não usa ferramentas de medição de visitas nem de anúncios, e não grava cookies próprios.
          </p>
        ) : (
          <>
            <p>As ferramentas abaixo só são carregadas se você clicar em “Aceitar” no aviso de privacidade:</p>
            <ul>
              {tools.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <p>
              Quando ativadas, elas registram eventos como cliques nos botões de WhatsApp, em “Como chegar”, na abertura de
              fotos e de perguntas frequentes. Esses eventos não incluem seu nome, telefone ou o texto da mensagem. Se você
              recusar, nada é carregado.
            </p>
            <p>
              <button type="button" class="btn btn--ghost" data-reset-consent>
                Rever minha escolha
              </button>
            </p>
          </>
        )
      }

      <h2>Armazenamento no navegador</h2>
      <p>
        O site pode guardar no seu navegador a sua escolha sobre medição e se você pausou o movimento decorativo do topo
        da página. Essas informações ficam só no seu dispositivo e podem ser apagadas nas configurações do navegador.
      </p>

      <h2>Fale com a academia</h2>
      <p>
        Dúvidas sobre este site: {business.whatsappDisplay} ·{' '}
        <a class="text-link" href={business.instagramUrl} target="_blank" rel="noopener noreferrer">
          {business.instagramHandle}<span class="sr-only"> (abre em nova aba)</span>
        </a>
      </p>
    </article>
  </main>
  <Footer home={false} />
  <MobileConversionBar />
</BaseLayout>

<script>
  document.querySelector('[data-reset-consent]')?.addEventListener('click', () => {
    try {
      localStorage.removeItem('rip-consent-v1');
    } catch {
      /* ignora */
    }
    window.location.reload();
  });
</script>

<style>
  .privacy {
    max-width: 760px;
  }
  .privacy h1 {
    margin-top: 16px;
    font-size: clamp(2.4rem, 1.6rem + 3vw, 3.6rem);
    text-transform: uppercase;
  }
  .privacy h2 {
    margin-top: 40px;
    font-size: 1.6rem;
  }
  .privacy p,
  .privacy ul {
    margin-top: 14px;
    color: #d4d4da;
  }
</style>
