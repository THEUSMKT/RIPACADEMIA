---
import manifest from '../data/images.json';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
import WhatsAppLink from './WhatsAppLink.astro';

interface Props {
  /** Na home os links são âncoras locais; nas demais páginas apontam para a home. */
  home?: boolean;
}
const { home = true } = Astro.props;
const prefix = home ? '' : withBase('');
const nav = [
  { href: `${prefix}#estrutura`, label: 'Estrutura' },
  { href: `${prefix}#modalidades`, label: 'Modalidades' },
  { href: `${prefix}#beneficios`, label: 'Benefícios' },
  { href: `${prefix}#localizacao`, label: 'Localização' },
];
const logo = manifest.brand.logo;
const logoH = 54;
const logoW = Math.round((logo.width * logoH) / logo.height);
---

<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="site-header__logo" href={withBase('')} aria-label="RIP Academia — início">
      <picture>
        <source type="image/webp" srcset={withBase('assets/brand/logo-rip-400.webp')} />
        <img src={withBase('assets/brand/logo-rip-400.png')} alt="RIP Academia, desde 2000" width={logoW} height={logoH} />
      </picture>
    </a>

    <nav class="site-nav" aria-label="Principal">
      <button
        type="button"
        class="site-nav__toggle"
        aria-expanded="false"
        aria-controls="menu-principal"
        data-menu-toggle
      >
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
        <span class="site-nav__toggle-label">Menu</span>
      </button>
      <div class="site-nav__panel" id="menu-principal" data-menu-panel>
        <ul class="site-nav__list">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="site-nav__link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <WhatsAppLink intent="free_pass" placement="menu_mobile" ctaId="menu_free_pass" class="site-nav__panel-cta">
          Agendar Free Pass
        </WhatsAppLink>
      </div>
    </nav>

    <WhatsAppLink intent="free_pass" placement="header" ctaId="header_free_pass" class="site-header__cta">
      Agendar Free Pass
    </WhatsAppLink>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  // Fundo do header após o início do scroll (sem listener de scroll: um sentinela no topo).
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:24px;pointer-events:none;';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => header.classList.toggle('is-scrolled', !entry.isIntersecting)).observe(sentinel);
  }

  if (toggle && panel) {
    const mq = window.matchMedia('(min-width: 1024px)');
    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('.site-nav__toggle-label')!.textContent = open ? 'Fechar' : 'Menu';
      header?.classList.toggle('menu-open', open);
      document.documentElement.classList.toggle('menu-is-open', open);
      if (open) panel.querySelector<HTMLElement>('a')?.focus();
      else if (returnFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    // Fecha após escolher um link.
    panel.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });
    // Fecha ao clicar fora.
    document.addEventListener('click', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (e.target instanceof Node && (panel.contains(e.target) || toggle.contains(e.target))) return;
      setOpen(false);
    });
    // Fecha ao sair do painel com Tab.
    panel.addEventListener('focusout', (e) => {
      const next = e.relatedTarget;
      if (!mq.matches && next instanceof Node && !panel.contains(next) && next !== toggle) setOpen(false);
    });
    mq.addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgb(9 9 11 / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .site-header.is-scrolled,
  .site-header.menu-open {
    background: rgb(21 21 24 / 0.96);
    border-bottom-color: var(--line);
  }
  .site-header__bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .site-header__logo {
    display: block;
    flex: none;
    border-radius: 4px;
  }
  .site-header__logo img {
    height: 54px;
    width: auto;
    /* O fundo preto do recorte se funde à superfície escura do header. */
    mix-blend-mode: lighten;
  }

  .site-nav {
    margin-left: auto;
  }
  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 14px;
    font-weight: 550;
    font-size: 0.98rem;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius);
    position: relative;
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 10px;
    height: 2px;
    background: var(--brand-red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .site-nav__link:hover::after,
  .site-nav__link:focus-visible::after {
    transform: scaleX(1);
  }
  .site-nav__toggle,
  .site-nav__panel-cta {
    display: none;
  }
  .site-header__cta {
    min-height: 48px;
    padding: 10px 18px;
  }

  @media (max-width: 1023px) {
    .site-header__logo img {
      height: 46px;
    }
    .site-nav__toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 48px;
      min-width: 48px;
      padding: 0 14px;
      background: transparent;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      cursor: pointer;
      font-weight: 600;
    }
    .site-nav__toggle .icon-close,
    .site-nav__toggle[aria-expanded='true'] .icon-open {
      display: none;
    }
    .site-nav__toggle[aria-expanded='true'] .icon-close {
      display: block;
    }
    /* Painel suspenso (não full-screen): a barra de conversão continua visível. */
    .site-nav__panel {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      padding: 8px var(--gutter) 20px;
      box-shadow: var(--shadow);
      display: none;
    }
    .menu-open .site-nav__panel {
      display: block;
    }
    .site-nav__list {
      flex-direction: column;
      gap: 0;
    }
    .site-nav__link {
      width: 100%;
      min-height: 52px;
      padding: 0 4px;
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      border-bottom: 1px solid var(--line);
    }
    .site-nav__link::after {
      display: none;
    }
    .site-nav__panel-cta {
      display: flex;
      width: 100%;
      margin-top: 16px;
    }
    .site-header__cta {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .site-nav__toggle-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
