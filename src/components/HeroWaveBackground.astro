---
/**
 * Fundo decorativo do hero — Ribbon Glow (seção 7.1 do briefing).
 *
 * Camadas (de baixo para cima, todas aria-hidden e sem eventos de ponteiro):
 *  1. fundo estático equivalente (SVG com gradientes) — sempre presente; é o que aparece no mobile,
 *     com movimento reduzido, sem WebGL2 ou em caso de erro;
 *  2. canvas WebGL2 — só no desktop, carregado depois da página pronta, com opacidade ~0,26;
 *  3. máscara escura — garante contraste constante atrás do texto e dos botões.
 *
 * O botão "Pausar movimento" fica fora deste bloco (no Hero) para não herdar pointer-events: none.
 */
---

<div class="wave" aria-hidden="true">
  <svg class="wave__static" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" focusable="false">
    <defs>
      <linearGradient id="wave-g1" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#8F1018" stop-opacity="0" />
        <stop offset="0.35" stop-color="#8F1018" stop-opacity="0.9" />
        <stop offset="0.62" stop-color="#F20A16" />
        <stop offset="1" stop-color="#8F1018" stop-opacity="0.2" />
      </linearGradient>
      <filter id="wave-blur" x="-10%" y="-50%" width="120%" height="200%">
        <feGaussianBlur stdDeviation="14" />
      </filter>
      <filter id="wave-soft" x="-10%" y="-50%" width="120%" height="200%">
        <feGaussianBlur stdDeviation="2.5" />
      </filter>
    </defs>
    <g fill="none" stroke="url(#wave-g1)" stroke-linecap="round">
      <path d="M-40 820 C 260 760, 520 860, 760 700 S 1180 520, 1500 610" stroke-width="70" opacity="0.32" filter="url(#wave-blur)" />
      <path d="M-40 828 C 260 768, 520 868, 760 708 S 1180 528, 1500 618" stroke-width="6" opacity="0.75" filter="url(#wave-soft)" />
      <path d="M-40 850 C 280 800, 540 880, 780 742 S 1200 580, 1500 660" stroke-width="2" opacity="0.5" />
    </g>
  </svg>
  <canvas class="wave__canvas" data-wave-canvas></canvas>
  <div class="wave__mask"></div>
</div>

<style>
  .wave {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
  }
  .wave__static,
  .wave__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wave__static {
    opacity: 0.55;
    transition: opacity 0.8s var(--ease);
  }
  .wave__canvas {
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  /* Renderer ativo: o canvas assume o papel do fundo estático. */
  :global([data-wave='live']) .wave__canvas {
    opacity: 0.3;
  }
  :global([data-wave='live']) .wave__static {
    opacity: 0;
  }

  /*
   * Máscara: região escura estável atrás do texto (coluna esquerda e topo) e faixa inferior
   * mais aberta para a onda aparecer na borda inferior e na transição texto/foto.
   */
  .wave__mask {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 36% 58% at 27% 52%, rgb(9 9 11 / 0.95) 0%, rgb(9 9 11 / 0.9) 62%, rgb(9 9 11 / 0) 100%),
      linear-gradient(180deg, rgb(9 9 11 / 0.9) 0%, rgb(9 9 11 / 0) 30%);
  }
  @media (max-width: 1023px) {
    .wave__mask {
      background:
        linear-gradient(180deg, rgb(9 9 11 / 0.92) 0%, rgb(9 9 11 / 0.7) 60%, rgb(9 9 11 / 0.1) 100%);
    }
  }
</style>
