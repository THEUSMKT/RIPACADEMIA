---
/**
 * Encerramento: foto de treino inteira e a mensagem final, com um único CTA local (Free Pass).
 * Desktop: mensagem e foto lado a lado. Mobile: frase e CTA acima da foto.
 * Entrada: a foto aparece com fade e deslocamento discreto, seguida da frase (≈ 0,9 s, uma vez).
 */
import { business } from '../data/business';
import { ratioVar } from '../lib/images';
import Photo from './Photo.astro';
import WhatsAppLink from './WhatsAppLink.astro';
---

<section class="section final" aria-labelledby="final-title">
  <div class="container final__grid" data-reveal>
    <div class="final__copy">
      <h2 id="final-title">Sua melhor versão começa com o <span class="accent">primeiro passo.</span></h2>
      <p class="lede">Venha conhecer a RIP e dê o seu primeiro passo.</p>
      <WhatsAppLink intent="free_pass" placement="fechamento" ctaId="fechamento_free_pass">
        {business.freePass.cta}
      </WhatsAppLink>
    </div>
    <div class="final__media">
      <div class="frame frame--fit final__frame" style={ratioVar('encerramento-primeiro-passo')}>
        <Photo id="encerramento-primeiro-passo" sizes="(min-width: 1024px) 480px, (min-width: 600px) 440px, 92vw" />
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    background: var(--surface);
  }
  .final__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }
  .final__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .final__copy h2 {
    font-size: clamp(2.4rem, 1.4rem + 4vw, 4.6rem);
  }
  .final__copy :global(.btn) {
    margin-top: 6px;
  }
  .final__media {
    display: flex;
    justify-content: flex-end;
  }
  .final__frame {
    --fit-h: min(78vh, 680px);
  }

  /* Sequência: foto primeiro, frase depois. Sem escala nem zoom. */
  :global(.reveal-on) .final__grid[data-reveal] {
    opacity: 1;
    transform: none;
  }
  :global(.reveal-on) .final__media,
  :global(.reveal-on) .final__copy {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.55s var(--ease),
      transform 0.55s var(--ease);
  }
  :global(.reveal-on) .final__copy {
    transition-delay: 0.35s;
  }
  :global(.reveal-on) .final__grid:global(.is-in) .final__media,
  :global(.reveal-on) .final__grid:global(.is-in) .final__copy {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1023px) {
    .final__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .final__media {
      justify-content: flex-start;
    }
    .final__frame {
      --fit-h: min(72vh, 620px);
    }
  }
  @media (max-width: 599px) {
    .final__copy :global(.btn) {
      width: 100%;
    }
  }
</style>
