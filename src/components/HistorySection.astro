---
import { business } from '../data/business';
import WhatsAppLink from './WhatsAppLink.astro';

// Avaliações só aparecem se houver itens autênticos em business.reviews (texto, autoria, fonte e link).
const reviews = business.reviews;
---

<section class="section history" id="historia" aria-labelledby="historia-title">
  <!-- Sem foto: a foto de grupo saiu (não representa a equipe completa). Ano grande e texto lado a lado. -->
  <div class="container history__grid" data-reveal>
    <p class="history__year" aria-hidden="true">{business.brandSince}</p>
    <div class="history__copy">
      <p class="eyebrow">História</p>
      <h2 id="historia-title">Uma história que começou em {business.brandSince}.</h2>
      <p class="lede">
        A RIP Academia reúne uma história de treino em São Leopoldo e um espaço para você conhecer pessoalmente.
        Converse com a equipe e encontre uma forma de começar.
      </p>
      <WhatsAppLink intent="plans" placement="historia" ctaId="historia_conversar" variant="ghost" icon="arrow">
        Conversar com a equipe
      </WhatsAppLink>
    </div>
  </div>

  {
    reviews.length > 0 && (
      <div class="container history__reviews">
        <h3>O que dizem sobre a RIP</h3>
        <ul>
          {reviews.map((r) => (
            <li>
              <blockquote>
                <p>{r.text}</p>
              </blockquote>
              <p class="history__review-meta">
                {r.author} ·{' '}
                <a class="text-link" href={r.url} target="_blank" rel="noopener noreferrer">
                  {r.source}
                  <span class="sr-only"> (abre em nova aba)</span>
                </a>
              </p>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .history {
    background: var(--surface);
    overflow: hidden;
  }
  .history__grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(32px, 6vw, 112px);
    align-items: center;
  }
  .history__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 640px;
  }
  /* Ano em contorno, como grafismo estático; ocupa a coluna que era da foto. */
  .history__year {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(5rem, 2rem + 11vw, 15rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(242 10 22 / 0.55);
    letter-spacing: 0.02em;
    user-select: none;
  }
  .history__reviews {
    margin-top: var(--section-y);
  }
  .history__reviews ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .history__reviews li {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .history__reviews blockquote {
    margin: 0;
  }
  .history__review-meta {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 767px) {
    .history__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
