---
/** Ícones de traço simples, decorativos (aria-hidden). O texto do controle carrega o significado. */
interface Props {
  name: 'whatsapp' | 'arrow' | 'arrow-down' | 'map' | 'instagram' | 'phone' | 'menu' | 'close' | 'plus' | 'chevron-left' | 'chevron-right';
  class?: string;
  [key: `data-${string}`]: unknown;
}
const { name, class: className, ...rest } = Astro.props;
---

<svg {...rest} class={className} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'whatsapp' && (
    <>
      <path d="M3.5 20.5l1.3-4.1A8.5 8.5 0 1 1 8 19.6z" />
      <path d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .6.6 1 1.4 1.8 2.4 2.3.2.1.4.1.6-.1l.6-.6c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.3.3.5v.4c0 .4-.2.8-.6 1-1 .6-2.3.4-4.4-1-1.7-1.2-2.9-3-3.2-4.3-.1-.7 0-1.4.2-1.8z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === 'map' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'phone' && <path d="M5 4h3.5l1.7 4.3-2.2 1.4a11 11 0 0 0 6.3 6.3l1.4-2.2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h10" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'chevron-left' && <path d="M15 5l-7 7 7 7" />}
  {name === 'chevron-right' && <path d="M9 5l7 7-7 7" />}
</svg>
