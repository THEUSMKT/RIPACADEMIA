---
import manifest from '../data/images.json';
import { galleryGroups } from '../data/gallery';
import { photoMeta } from '../data/photos';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
import Photo from './Photo.astro';

type Entry = { w: number; file: string };
const photos = manifest.photos as Record<string, { width: number; height: number; variants: { avif: Entry[]; webp: Entry[] } }>;
const srcset = (list: Entry[]) => list.map((v) => `${withBase(v.file)} ${v.w}w`).join(', ');

const items = galleryGroups.flatMap((g) => g.items.map((id) => ({ id, group: g.title })));
const lightboxData = items.map(({ id, group }) => {
  const p = photos[id];
  return {
    id,
    group,
    alt: photoMeta[id].alt,
    width: p.width,
    height: p.height,
    avif: srcset(p.variants.avif),
    webp: srcset(p.variants.webp),
    src: withBase(p.variants.webp[p.variants.webp.length - 1].file),
  };
});
---

<section class="section gallery" id="galeria" aria-labelledby="galeria-title">
  <div class="container">
    <header class="gallery__head" data-reveal>
      <div>
        <p class="eyebrow">Galeria</p>
        <h2 id="galeria-title">Por dentro da RIP.</h2>
      </div>
    </header>

    <ul class="gallery__grid">
      {
        items.map(({ id, group }, i) => (
          <li class={`gallery__item gallery__item--${i}`} data-reveal>
            <button
              type="button"
              class="gallery__btn"
              data-gallery-index={i}
              aria-haspopup="dialog"
              aria-label={`Ampliar foto: ${group}. ${photoMeta[id].alt}`}
            >
              <span class="frame gallery__frame">
                <Photo id={id} sizes="(min-width: 1024px) 30vw, (min-width: 600px) 45vw, 46vw" />
              </span>
              <span class="gallery__tag">{group}</span>
              <span class="gallery__zoom" aria-hidden="true">
                <Icon name="expand" />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-labelledby="lightbox-caption" data-lightbox>
    <div class="lightbox__inner">
      <figure class="lightbox__figure">
        <picture data-lightbox-picture>
          <source type="image/avif" />
          <source type="image/webp" />
          <img alt="" data-lightbox-img />
        </picture>
        <figcaption id="lightbox-caption" class="lightbox__caption">
          <span data-lightbox-count></span>
          <span data-lightbox-alt></span>
        </figcaption>
      </figure>
      <div class="lightbox__controls">
        <button type="button" class="lightbox__btn" data-lightbox-prev>
          <Icon name="chevron-left" />
          <span class="sr-only">Foto anterior</span>
        </button>
        <button type="button" class="lightbox__btn" data-lightbox-next>
          <Icon name="chevron-right" />
          <span class="sr-only">Próxima foto</span>
        </button>
        <button type="button" class="lightbox__btn lightbox__close" data-lightbox-close>
          <Icon name="close" />
          <span>Fechar</span>
        </button>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="gallery-data" set:html={JSON.stringify(lightboxData)} />
</section>

<script>
  import { track } from '../lib/analytics';

  type Item = { id: string; group: string; alt: string; width: number; height: number; avif: string; webp: string; src: string };

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const dataEl = document.getElementById('gallery-data');
  if (dialog && dataEl && typeof dialog.showModal === 'function') {
    const items: Item[] = JSON.parse(dataEl.textContent || '[]');
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const [avif, webp] = Array.from(dialog.querySelectorAll<HTMLSourceElement>('[data-lightbox-picture] source'));
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const altText = dialog.querySelector<HTMLElement>('[data-lightbox-alt]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const it = items[index];
      // Limitado ao tamanho natural: sizes = largura natural.
      const sizes = `min(${it.width}px, 92vw)`;
      avif.srcset = it.avif;
      avif.sizes = sizes;
      webp.srcset = it.webp;
      webp.sizes = sizes;
      img.src = it.src;
      img.width = it.width;
      img.height = it.height;
      img.alt = it.alt;
      count.textContent = `${index + 1} de ${items.length} · ${it.group}`;
      altText.textContent = it.alt;
    };

    const open = (i: number, trigger: HTMLElement) => {
      opener = trigger;
      show(i);
      dialog.showModal();
      document.documentElement.classList.add('dialog-open');
      dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.focus();
      track('gallery_open', { image_id: items[index].id });
    };

    document.querySelectorAll<HTMLButtonElement>('[data-gallery-index]').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.galleryIndex), btn));
    });

    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // Clique no fundo (fora da figura e dos controles) fecha.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Escape: o <dialog> modal já fecha com "cancel". Ao fechar, devolve o foco ao acionador.
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('dialog-open');
      opener?.focus();
    });

    // Gesto de deslizar complementa (não substitui) os botões.
    let startX = 0;
    let startY = 0;
    dialog.addEventListener(
      'touchstart',
      (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      },
      { passive: true },
    );
    dialog.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>

<style>
  .gallery {
    background: var(--background);
  }
  .gallery__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .gallery__head > div {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* Grid editorial assimétrico, moderado. */
  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(120px, 14vw, 190px);
    gap: clamp(10px, 1.6vw, 20px);
  }
  .gallery__item {
    min-width: 0;
  }
  .gallery__item--0 {
    grid-column: 1 / span 5;
    grid-row: span 3;
  }
  .gallery__item--1 {
    grid-column: 6 / span 4;
    grid-row: span 2;
  }
  .gallery__item--2 {
    grid-column: 10 / span 3;
    grid-row: span 2;
  }
  .gallery__item--3 {
    grid-column: 6 / span 3;
    grid-row: span 2;
  }
  .gallery__item--4 {
    grid-column: 9 / span 4;
    grid-row: span 2;
  }
  .gallery__item--5 {
    grid-column: 1 / span 5;
    grid-row: span 1;
  }
  .gallery__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-lg);
    text-align: left;
  }
  .gallery__frame {
    display: block;
    height: 100%;
  }
  .gallery__frame :global(picture),
  .gallery__frame :global(img) {
    height: 100%;
    width: 100%;
  }
  .gallery__tag {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 5px 10px;
    border-radius: 4px;
    background: rgb(9 9 11 / 0.78);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .gallery__zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(9 9 11 / 0.78);
    opacity: 0.85;
    transition: background-color 0.2s var(--ease);
  }
  .gallery__btn:hover .gallery__zoom,
  .gallery__btn:focus-visible .gallery__zoom {
    background: var(--action-red);
  }

  @media (max-width: 767px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(150px, 46vw, 260px);
    }
    .gallery__grid > .gallery__item {
      grid-column: auto;
      grid-row: span 1;
    }
    .gallery__grid > .gallery__item--0 {
      grid-row: span 2;
    }
    .gallery__grid > .gallery__item--5 {
      grid-column: 1 / -1;
    }
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(5 5 6 / 0.96);
    color: var(--text);
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.7);
  }
  .lightbox__inner {
    height: 100%;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    padding: max(16px, env(safe-area-inset-top)) 16px max(16px, env(safe-area-inset-bottom));
    gap: 12px;
  }
  .lightbox__figure {
    margin: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .lightbox__figure picture {
    min-height: 0;
    display: flex;
    justify-content: center;
  }
  .lightbox__figure img {
    max-height: calc(100vh - 170px);
    max-height: calc(100dvh - 170px);
    width: auto;
    max-width: min(100%, 92vw);
    object-fit: contain;
    border-radius: var(--radius);
  }
  .lightbox__caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
    max-width: 70ch;
  }
  .lightbox__caption [data-lightbox-count] {
    font-weight: 600;
    color: var(--text);
  }
  .lightbox__controls {
    display: flex;
    justify-content: center;
    gap: 12px;
  }
  .lightbox__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 52px;
    min-height: 52px;
    padding: 0 16px;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    cursor: pointer;
    font-weight: 600;
  }
  .lightbox__btn:hover {
    background: var(--surface-elevated);
  }
  .lightbox__close {
    background: var(--action-red);
    border-color: var(--action-red);
    color: #fff;
  }
  .lightbox__close:hover {
    background: var(--action-hover);
  }
</style>
