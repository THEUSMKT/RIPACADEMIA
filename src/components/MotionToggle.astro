---
/**
 * Controle discreto "Pausar movimento" / "Retomar movimento" das ondas (WCAG 2.2.2).
 * Só ícone, alvo de toque 48 × 48 px, num canto da seção longe dos CTAs. Vale para todas as ondas
 * da página e fica oculto enquanto a seção não tem animação (movimento reduzido, sem WebGL2 ou antes
 * do renderer iniciar). A lógica fica em src/scripts/wave-controller.ts.
 */
import Icon from './Icon.astro';

interface Props {
  /** Canto da seção: embaixo (padrão) ou no alto, quando a base da seção é coberta pela seção seguinte. */
  corner?: 'bottom' | 'top';
}
const { corner = 'bottom' } = Astro.props;
---

<button type="button" class={`motion-toggle motion-toggle--${corner}`} data-motion-toggle aria-pressed="false" aria-label="Pausar movimento" hidden>
  <Icon name="pause" class="icon-pause" />
  <Icon name="play" class="icon-play" />
</button>

<style>
  .motion-toggle {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    color: var(--muted);
    background: rgb(9 9 11 / 0.45);
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .motion-toggle--bottom {
    bottom: 14px;
  }
  .motion-toggle--top {
    top: 14px;
  }
  .motion-toggle svg {
    width: 16px;
    height: 16px;
  }
  .motion-toggle:hover,
  .motion-toggle:focus-visible {
    color: var(--text);
    border-color: var(--line-strong);
    background: rgb(9 9 11 / 0.7);
  }
  .motion-toggle .icon-play,
  .motion-toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }
  .motion-toggle[aria-pressed='true'] .icon-play {
    display: block;
  }
</style>
