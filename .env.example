# Copie para .env (não versionado) para testar localmente. Em produção, use as
# Repository variables do GitHub (Settings → Secrets and variables → Actions → Variables).

# Mensuração — vazio = desligado. Com qualquer ID, aparece o aviso de consentimento.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_META_PIXEL_ID=
# true = escreve os eventos no console do navegador (funciona mesmo sem IDs)
PUBLIC_ANALYTICS_DEBUG=

# URL oficial da unidade no Google Maps, quando confirmada (senão usa busca pelo endereço)
PUBLIC_MAPS_URL=

# Endereço de publicação (padrão: https://theusmkt.github.io + /RIPACADEMIA)
SITE_URL=
BASE_PATH=
