---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StructureSection from '../components/StructureSection.astro';
import ModalitiesSection from '../components/ModalitiesSection.astro';
import FreePassSection from '../components/FreePassSection.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import HistorySection from '../components/HistorySection.astro';
import InviteSection from '../components/InviteSection.astro';
import LocationSection from '../components/LocationSection.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import MobileConversionBar from '../components/MobileConversionBar.astro';
import { withBase } from '../lib/paths';

// Primeira tela: a logo grande da abertura (a fachada fica logo abaixo e carrega normalmente).
const logoSrcset = `${withBase('assets/brand/logo-rip-400.webp')} 400w, ${withBase('assets/brand/logo-rip-790.webp')} 790w`;
---

<BaseLayout
  title="RIP Academia na Feitoria | Musculação e CrossTraining em São Leopoldo"
  description="Conheça a RIP Academia na Feitoria, São Leopoldo. Veja a estrutura, os horários, Wellhub e TotalPass e converse com a equipe sobre o Free Pass."
  jsonLd
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={logoSrcset}
    imagesizes="(min-width: 1024px) 620px, 80vw"
    fetchpriority="high"
  />
  <Header />
  <main id="conteudo" tabindex="-1">
    <Hero />
    <StructureSection />
    <ModalitiesSection />
    <FreePassSection />
    <BenefitsSection />
    <HistorySection />
    <InviteSection />
    <LocationSection />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <MobileConversionBar />
</BaseLayout>

<script>
  // Fade-in com partículas vermelhas em cada foto, na primeira vez que ela entra na tela.
  import { initImageReveal } from '../scripts/image-reveal';
  initImageReveal();
</script>
