---
/**
 * Link real para o WhatsApp (funciona sem JavaScript). Os atributos data-* alimentam o analytics:
 * cta_id e placement descrevem a posição; intent é o código da intenção (nunca vai para a mensagem).
 */
import type { HTMLAttributes } from 'astro/types';
import { whatsappUrl, type Intent } from '../lib/whatsapp';
import Icon from './Icon.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'target' | 'rel'> {
  intent: Intent;
  placement: string;
  ctaId: string;
  variant?: 'primary' | 'ghost' | 'plain';
  class?: string;
  icon?: 'whatsapp' | 'arrow' | 'none';
}

// ...rest repassa o atributo de escopo (data-astro-cid-*) para que estilos do componente pai se apliquem.
const { intent, placement, ctaId, variant = 'primary', class: className, icon = 'whatsapp', ...rest } = Astro.props;
const classes = [variant === 'plain' ? '' : 'btn', variant === 'ghost' ? 'btn--ghost' : '', className].filter(Boolean).join(' ');
---

<a
  {...rest}
  href={whatsappUrl(intent)}
  target="_blank"
  rel="noopener noreferrer"
  class={classes}
  data-track="whatsapp"
  data-intent={intent}
  data-placement={placement}
  data-cta-id={ctaId}
>
  {icon === 'whatsapp' && <Icon name="whatsapp" />}
  <span><slot /></span>
  {icon === 'arrow' && <Icon name="arrow" class="btn__arrow" />}
  <span class="sr-only"> (abre o WhatsApp em nova aba)</span>
</a>
