---
import { business } from '../data/business';
import Photo from './Photo.astro';
import WaveBackground from './WaveBackground.astro';
import MotionToggle from './MotionToggle.astro';
import Icon from './Icon.astro';
import WhatsAppLink from './WhatsAppLink.astro';

const facts = [
  { label: `Desde ${business.brandSince}`, detail: 'história da marca' },
  { label: business.address.streetAddress, detail: `${business.address.neighborhood}, ${business.address.addressLocality}` },
  { label: business.benefits.join(' e '), detail: 'consulte as condições' },
];
---

<section class="hero" data-hero data-wave-host aria-labelledby="hero-title">
  <WaveBackground id="hero-wave" variant="hero" offsetWide={[0.1, -0.26]} offsetNarrow={[-0.05, 0.35]} sizeNarrow={55} />

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">
        RIP Academia · {business.address.neighborhood}, {business.address.addressLocality}
      </p>
      <h1 id="hero-title" class="hero__title">
        Seja sua <span class="accent">melhor versão.</span>
      </h1>
      <p class="hero__lede">
        Musculação e CrossTraining em uma estrutura que você pode conhecer de perto. Dê o primeiro passo e converse com
        a equipe sobre o seu Free Pass.
      </p>
      <div class="hero__actions">
        <WhatsAppLink intent="free_pass" placement="hero" ctaId="hero_free_pass" icon="whatsapp" class="hero__cta">
          {business.freePass.cta}
        </WhatsAppLink>
        <a class="btn btn--ghost" href="#estrutura">
          Conhecer a estrutura
          <Icon name="arrow-down" class="btn__arrow" />
        </a>
      </div>
      <p class="hero__micro">Agendamento pelo WhatsApp. Consulte horários e condições.</p>

      <ul class="hero__facts" aria-label="Destaques">
        {
          facts.map((f) => (
            <li>
              <strong>{f.label}</strong>
              <span>{f.detail}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero__media">
      <div class="frame hero__frame">
        <Photo id="fachada-rip" priority sizes="(min-width: 1280px) 560px, (min-width: 1024px) 44vw, (min-width: 600px) 520px, 100vw" />
      </div>
      <figcaption class="hero__caption">Fachada da RIP Academia, na {business.address.streetAddress}.</figcaption>
    </figure>
  </div>

  <MotionToggle />
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--background);
    padding-block: clamp(28px, 5vw, 64px) clamp(56px, 7vw, 96px);
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }
  .hero__copy {
    min-width: 0;
  }
  .hero__eyebrow {
    margin-bottom: 20px;
  }
  .hero__title {
    font-size: clamp(2.6rem, 1.2rem + 5.2vw, 5.5rem);
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: 0;
    max-width: 11ch;
  }
  .hero__title .accent {
    display: inline;
  }
  .hero__lede {
    margin-top: 22px;
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.22rem);
    color: #d4d4da;
    max-width: 50ch;
  }
  .hero__actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__cta {
    padding-inline: 28px;
    font-size: 1.05rem;
  }
  /* Cinza mais claro que o --muted padrão: o texto pequeno fica sobre a onda e precisa de 4,5:1 no pior quadro. */
  .hero__micro {
    margin-top: 12px;
    font-size: 0.92rem;
    color: #c6c6ce;
  }
  .hero__facts {
    list-style: none;
    margin: 36px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, auto));
    justify-content: start;
    gap: 12px 32px;
  }
  .hero__facts li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .hero__facts strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .hero__facts span {
    font-size: 0.88rem;
    color: #c6c6ce;
  }

  .hero__media {
    margin: 0;
    position: relative;
    min-width: 0;
  }
  /* Linha vermelha discreta acompanhando a foto. */
  .hero__media::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 12%;
    bottom: 18%;
    width: 3px;
    background: linear-gradient(180deg, transparent, var(--brand-red) 30%, var(--brand-red) 70%, transparent);
    transform: skewY(-12deg);
    z-index: 1;
  }
  /* Fachada inteira, na proporção original (vertical): a altura do bloco segue a foto. */
  .hero__frame {
    width: 100%;
    margin-left: auto;
    box-shadow: var(--shadow);
    animation: hero-media 0.6s var(--ease) 0.1s both;
  }
  .hero__caption {
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .hero__copy > * {
    animation: hero-in 0.5s var(--ease) both;
  }
  .hero__copy > :nth-child(2) {
    animation-delay: 0.05s;
  }
  .hero__copy > :nth-child(3) {
    animation-delay: 0.1s;
  }
  .hero__copy > :nth-child(n + 4) {
    animation-delay: 0.15s;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes hero-media {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }

  @media (max-width: 1023px) {
    .hero {
      /* Base mais alta: o controle de pausa (48 px) fica abaixo da legenda da foto, sem sobrepor. */
      padding-block: 24px 80px;
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .hero__title {
      font-size: clamp(2.5rem, 1.4rem + 5.4vw, 3.4rem);
      max-width: 12ch;
    }
    .hero__lede {
      margin-top: 16px;
    }
    .hero__actions {
      margin-top: 24px;
    }
    .hero__media::before {
      display: none;
    }
    .hero__media {
      max-width: 520px;
    }
  }

  @media (max-width: 599px) {
    .hero__eyebrow {
      font-size: 0.85rem;
      letter-spacing: 0.1em;
      margin-bottom: 14px;
    }
    .hero__actions .btn {
      width: 100%;
    }
    .hero__facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      margin-top: 28px;
    }
    .hero__facts li {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
    }
    .hero__facts strong {
      font-size: 1.15rem;
    }
  }
</style>
