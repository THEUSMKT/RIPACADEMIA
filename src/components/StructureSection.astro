---
import Photo from './Photo.astro';
import WhatsAppLink from './WhatsAppLink.astro';

// Só o que é visível nas fotos: sem metragem, contagem de máquinas, acessibilidade ou estacionamento.
const highlights = [
  { title: 'Salão de musculação', text: 'Fileiras de aparelhos com espaço de circulação entre eles.' },
  { title: 'Aparelhos e anilhas', text: 'Equipamentos de força em vermelho e preto, halteres e suportes.' },
  { title: 'Mezanino e área de treino', text: 'Escada de acesso ao piso superior e área para outros treinos.' },
];
---

<section class="section structure" id="estrutura" aria-labelledby="estrutura-title">
  <div class="container structure__grid">
    <div class="structure__copy" data-reveal>
      <p class="eyebrow">Estrutura real</p>
      <h2 id="estrutura-title">Conheça o espaço onde seu próximo treino acontece.</h2>
      <p class="lede">
        O salão da RIP reúne aparelhos de musculação, pesos livres e uma área de treino integrada, em um ambiente
        iluminado em vermelho e preto. A melhor forma de avaliar é ver de perto.
      </p>
      <ul class="structure__list">
        {
          highlights.map((h, i) => (
            <li>
              <span class="structure__num" aria-hidden="true">
                0{i + 1}
              </span>
              <div>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <WhatsAppLink intent="free_pass" placement="estrutura" ctaId="estrutura_conhecer" icon="arrow">
        Quero conhecer a RIP
      </WhatsAppLink>
    </div>

    <div class="structure__photos">
      <figure class="structure__main" data-reveal>
        <div class="frame">
          <Photo id="visao-geral-entrada" sizes="(min-width: 1024px) 34vw, (min-width: 600px) 58vw, 92vw" />
        </div>
        <figcaption>Vista geral do salão, em direção à entrada</figcaption>
      </figure>
      <figure class="structure__side" data-reveal>
        <div class="frame frame--cut-left">
          <Photo id="escada-e-aparelhos" sizes="(min-width: 1024px) 22vw, (min-width: 600px) 38vw, 92vw" />
        </div>
        <figcaption>Escada, aparelhos e área de treino</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .structure {
    background: var(--background);
  }
  .structure__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .structure__copy {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .structure__list {
    list-style: none;
    padding: 0;
    margin: 6px 0 10px;
    display: grid;
    gap: 0;
    width: 100%;
  }
  .structure__list li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .structure__list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .structure__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--brand-red);
    padding-top: 2px;
  }
  .structure__list h3 {
    font-size: 1.35rem;
  }
  .structure__list p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .structure__photos {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(14px, 2vw, 24px);
    align-items: start;
  }
  .structure__photos figure {
    margin: 0;
  }
  .structure__main .frame {
    aspect-ratio: 3 / 4.4;
  }
  .structure__side {
    margin-top: clamp(48px, 12vw, 160px) !important;
  }
  .structure__side .frame {
    aspect-ratio: 3 / 5;
  }
  .structure__photos :global(img) {
    height: 100%;
  }
  figcaption {
    margin-top: 10px;
    font-size: 0.88rem;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .structure__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .structure__copy {
      position: static;
    }
  }
  @media (max-width: 599px) {
    .structure__photos {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    }
    .structure__side {
      margin-top: 40px !important;
    }
  }
</style>
